# Sao chép thành .env rồi sửa:  cp .env.example .env
# KHÔNG commit file .env lên GitHub.

# ---------- MQTT ----------
# Wokwi publish lên broker public; khi test cục bộ đổi thành localhost
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Topic phải khớp với SITE/LOCATION/DEVICE_ID trong firmware.
# Có thể dùng wildcard, ví dụ iot/ptit/+/+/telemetry (sẽ nhận cả thiết bị của người khác trên broker public)
MQTT_TOPIC=iot/ptit/lab/esp32-tung-01/telemetry
MQTT_QOS=1

# ---------- InfluxDB ----------
INFLUX_URL=http://localhost:8086
INFLUX_ORG=ptit
INFLUX_TOKEN=doi-token-nay-thanh-chuoi-dai-ngau-nhien
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=admin12345
INFLUX_BUCKET_RAW=iot_raw
INFLUX_BUCKET_PROCESSED=iot_processed
# Retention policy: dữ liệu thô giữ ngắn, dữ liệu đã xử lý giữ lâu hơn
INFLUX_RAW_RETENTION=7d
INFLUX_PROCESSED_RETENTION=30d

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin12345

# ---------- Ingest ----------
# Chu kỳ (giây) ghi thống kê pipeline (số gói, mất gói, độ trễ) vào measurement pipeline_stats
STATS_INTERVAL_S=30
